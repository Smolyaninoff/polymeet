# Переменные окружения PolyMeet. Все значения ниже — значения по умолчанию,
# с ними система работает без .env. Чтобы что-то поменять: cp .env.example .env
# Комментарии — только на отдельных строках: в конце строки Compose может принять их за значение.

# --- Compose ---
# Порт фронтенда и API на хосте
WEB_PORT=80
# Число воркеров gunicorn в сервисе api
WEB_CONCURRENCY=2
# Ключ JavaScript API Яндекс Карт (developer.tech.yandex.ru); без него карта не загрузится
VITE_YMAPS_API_KEY=
# Из POSTGRES_* docker-compose.yml собирает DATABASE_URL
POSTGRES_USER=polymeet
POSTGRES_PASSWORD=polymeet
POSTGRES_DB=polymeet

# --- Приложение ---
# dev | test | prod; в prod обязателен свой JWT_SECRET
APP_ENV=dev
LOG_LEVEL=INFO
# Часовой пояс фильтра ленты «по дате»
APP_TIMEZONE=Europe/Moscow
REDIS_URL=redis://redis:6379/0

# --- Авторизация ---
# В prod обязательно заменить на длинную случайную строку
JWT_SECRET=dev-only-jwt-secret-change-me-in-production
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
# Параметры Argon2id; память — в КиБ
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
# Неудачных входов с одного IP за окно (секунды)
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SEC=900
# Домены e-mail для регистрации через запятую; пусто — любой домен
ALLOWED_EMAIL_DOMAINS=

# --- Геокодер (Nominatim) ---
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
# Обязателен по правилам Nominatim
GEOCODER_USER_AGENT="PolyMeet/1.0 (course project)"
# Не больше 1 запроса в секунду — правило Nominatim
GEOCODER_RPS=1
GEOCODER_TIMEOUT_SEC=1.5
GEOCODER_RETRIES=2
GEO_CACHE_TTL_DAYS=30
# Паузы между повторами фоновой задачи геокодирования, секунды
GEO_RETRY_DELAYS_SEC=300,900,3600

# --- Circuit Breaker геокодера ---
# Ошибок подряд до размыкания и время размыкания, секунды
CB_FAIL_MAX=5
CB_OPEN_SECONDS=60
# Размыкание по доле ошибок в окне
CB_WINDOW_SEC=30
CB_WINDOW_MIN_CALLS=10
CB_WINDOW_FAIL_RATE=0.5

# --- Лента ---
FEED_CACHE_TTL_SEC=30
